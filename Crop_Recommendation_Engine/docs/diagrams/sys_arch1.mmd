    scaler_pkl -.-> feat_eng
    encoders -.-> feat_eng
    profiles -.-> guardrails
    profiles -.-> advisory

    openmeteo -.->|"Temp, Rain,\nHumidity"| feat_eng
    agrosensor -.->|"NPK, pH,\nEC, Moisture"| feat_eng
    groq -.->|"Cross-validation\n(offline)"| recommender

