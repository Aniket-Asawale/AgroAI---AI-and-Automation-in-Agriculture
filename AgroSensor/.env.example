# AgroSensor Environment Configuration
# Copy this to .env and adjust values for your setup

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=agro
DB_NAME=agrosensor

# Sensor / Modbus
SENSOR_COM_PORT=COM5
SENSOR_BAUD_RATE=9600
SENSOR_MODBUS_ADDRESS=1
SENSOR_WARMUP_SECONDS=15

# Polling
POLLING_INTERVAL_SECONDS=5
POLLING_ENABLED=true

# API Server
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true

